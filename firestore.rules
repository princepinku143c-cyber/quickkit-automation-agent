
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'OWNER'];
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // USERS: Users can read/write their own profile. Admins can read all.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // PROJECTS: Users manage their own. Admins can view/debug.
    match /projects/{projectId} {
      allow read, write: if resource.data.userId == request.auth.uid || isAdmin();
      allow create: if request.auth != null;
    }

    // PAYMENTS: Admin Only Read (Strict). Users can create (via webhook/functions), but direct write is restricted.
    match /payments/{paymentId} {
      allow read: if isAdmin(); // Only admins see full transaction history
      allow write: if false; // Only Cloud Functions should write here
    }

    // COUPONS: Admin Read/Write. Users Read Only.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // EXECUTION LOGS: Users read own.
    match /execution_logs/{logId} {
      allow read: if resource.data.userId == request.auth.uid || isAdmin();
      allow create: if request.auth != null;
    }
    
    // Default Block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
